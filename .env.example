# --- Database ---
DATABASE_URL="postgresql://instagram_agent:instagram_agent@localhost:5432/instagram_agent"

# --- Redis / Queue ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# --- Token encryption (packages/crypto) ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# --- AI Gateway (Anthropic) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Instagram integration ---
# "mock" (default, no real Meta app needed) or "real"
INSTAGRAM_CLIENT_MODE="mock"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/instagram/oauth/callback"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="replace-with-any-random-string"

# --- Storage ---
# "local" (default, writes to ./.data/media) or "s3"
STORAGE_ADAPTER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# --- App ---
NODE_ENV="development"
